# 部署配置 —— 复制成 .env 后修改
#
#   copy deploy\.env.example deploy\.env
#
# 至少要改这两个密码。改完再 docker compose up -d。

# ---- 必须修改 --------------------------------------------------------

# CouchDB 管理员密码。首次启动时由 CouchDB 镜像创建该账号，
# 应用随后用它建库、建应用账号、写权限文档。
# 请改成你自己的强密码。
COUCHDB_ADMIN_PASS=change-me-please

# ---- 按需要修改 ------------------------------------------------------

# CouchDB 管理员用户名（一般不用改）
COUCHDB_ADMIN_USER=admin

# 订单数据库名
COUCHDB_DB=orders

# 对外访问地址。决定 Caddy 用哪种证书：
#   localhost            本机自测
#   192.168.1.10         内网部署（推荐填本机局域网 IP，自动签内部 CA 证书）
#   orders.example.com   有公网域名（自动申请 Let's Encrypt 可信证书）
SITE_ADDRESS=localhost

# 对外端口。若 80/443 已被占用（例如 NAS 上已有别的服务），改成别的端口，
# 例如 HTTP_PORT=8080 HTTPS_PORT=8443
HTTP_PORT=80
HTTPS_PORT=443
